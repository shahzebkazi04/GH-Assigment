   "source": [
    "import re\n",
    "\n",
    "pan = input(\"Enter PAN Number: \")\n",
    "\n",
    "pattern = \"^[A-Z]{5}[0-9]{4}[A-Z]$\"\n",
    "\n",
    "if re.match(pattern, pan):\n",
    "    print(\"Valid PAN Number\")\n",
    "else:\n",
    "    print(\"Invalid PAN Number\")"
   ]
  }
